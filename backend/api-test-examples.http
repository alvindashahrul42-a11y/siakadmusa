DELETE http://localhost:5000/api/school-profile/<SCHOOL_PROFILE_ID>

###################################################
### NOTES FOR FILE UPLOAD (LOGO)
###################################################

# To upload a logo, use multipart/form-data with a REST client like Postman
# or Thunder Client in VS Code. Example:
#
# POST http://localhost:5000/api/school-profile
# Authorization: Bearer <ADMIN_TOKEN>
# Content-Type: multipart/form-data
# 
# Form Data:
# - logo: [SELECT FILE]
# - school_name: SMK MUSA
# - tagline: Mewujudkan Siswa yang Unggul
# - description: ...
# - address: ...
# - phone: ...
# - email: ...
# - website: ...
# - vision: ...
# - mission: ...
# - instagram: ...
# - facebook: ...
# - youtube: ...
